.git
.gitignore
build/
build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
*.o
*.a
*.so
*.so.*
*.pyc
__pycache__/
.pytest_cache/
.node_modules/
node_modules/
*.zip
*.tar
*.tar.gz
*.tgz
*.deb
*.log
.env

# Offline/Air-Gap Artefakte werden nicht in normale Docker-Build-Kontexte
# kopiert. Sie bleiben fuer separate Bundles im Repository-Layout erhalten.
runtime-libs/*
!runtime-libs/.gitkeep
!runtime-libs/README.md
offline-debs/*
!offline-debs/.gitkeep
!offline-debs/README.md
third_party/build/
third_party/stage/*
!third_party/stage/.gitkeep
third_party/sources/*
!third_party/sources/.gitkeep
!third_party/sources/README.md
dist/
out/
.venv/
venv/
suricata-monitor/.venv/
suricata-monitor/venv/
