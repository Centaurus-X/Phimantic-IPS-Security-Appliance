PHIMANTEC_VERSION=0.3.18-monitor-offline-vendor
PHIMANTEC_COMPOSE_PROJECT_NAME=phimantec-c11-v0318
PHIMANTEC_COMPOSE_PROJECT=phimantec-c11-v0318

# Externe Appliance-Ports.
# v0.3.18 nutzt host-network statt Docker-Userland-Proxy/NAT fuer Proxy und Webmanagement.
# Dadurch verschwinden 127.0.0.1-Publish-/Docker-NAT-Sonderfaelle.
PHIMANTEC_PROXY_PORT=3128
PHIMANTEC_MONITOR_PORT=5050

# Interne PHIMANTEC-Servicekanäle bleiben bewusst lokal am Docker-Host.
PHIMANTEC_LANE_PORT=127.0.0.1:18080
PHIMANTEC_FLOWBUS_PORT=127.0.0.1:18090

PHIMANTEC_FLOWBUS_TOKEN=phimantec-docker-token-change-me

# Pool-/Timing-Knobs fuer Proxy -> Lane -> Suricata -> FlowBus.
# Stabile Default-Basis: frische FlowBus-Verbindung pro Verdict.
# Wichtig: Suricata-Decision muss klar unter dem Proxy-Verdict-Read-Budget liegen.
PHIMANTEC_LANE_POOL_SIZE=16
PHIMANTEC_FLOWBUS_POOL_SIZE=16
PHIMANTEC_FLOWBUS_TIMEOUT_MS=3000
PHIMANTEC_FLOWBUS_CONNECT_TIMEOUT_MS=500
PHIMANTEC_FLOWBUS_READ_TIMEOUT_MS=3000
PHIMANTEC_FLOWBUS_KEEPALIVE=0
PHIMANTEC_PROXY_VERDICT_TIMEOUT_MS=3000
PHIMANTEC_PROXY_VERDICT_TIMEOUT_UNDER_LOAD_MS=8000
PHIMANTEC_SURICATA_DECISION_TIMEOUT_MS=900
PHIMANTEC_INSPECTORD_NO_ALERT_GRACE_MS=100

# v0.3.18: H1.1-only mode und stabilere Seitenladung ohne Security-Bypass.
PHIMANTEC_HTTP_MODE=h1_only
PHIMANTEC_DOWNSTREAM_ALPN=http/1.1
PHIMANTEC_UPSTREAM_ALPN=http/1.1
PHIMANTEC_STRIP_ALT_SVC=1
PHIMANTEC_STRIP_UPGRADE_HEADERS=1
PHIMANTEC_PRECONNECT_GRACE_MS=250
PHIMANTEC_FIRST_REQUEST_TIMEOUT_MS=1500
PHIMANTEC_IDLE_TUNNEL_TIMEOUT_MS=30000
PHIMANTEC_SAMPLE_TARGET_BYTES=524288
PHIMANTEC_SAMPLE_MAX_BYTES=1048576
PHIMANTEC_STREAM_CHUNK_MIN_BYTES=524288
PHIMANTEC_INSPECTION_QUEUE_MAX=1024
PHIMANTEC_INSPECTION_QUEUE_WAIT_MS=3000
PHIMANTEC_INSPECTION_MAX_INFLIGHT=128
PHIMANTEC_INSPECTION_MAX_INFLIGHT_PER_HOST=32
PHIMANTEC_INSPECTION_MAX_INFLIGHT_PER_CLIENT=96
PHIMANTEC_LANE_KEEPALIVE=1
PHIMANTEC_INSPECTION_FAIL_POLICY=closed

# host-network runtime: auto setzt bei lokaler Lane automatisch lo, sonst das Host-Interface.
PHIMANTEC_SURICATA_INTERFACE=auto
PHIMANTEC_SURICATA_RUNMODE=workers
PHIMANTEC_SURICATA_MPM=hs
PHIMANTEC_SURICATA_SPM=hs
PHIMANTEC_SURICATA_AF_PACKET_THREADS=auto
PHIMANTEC_SURICATA_BODY_LIMIT=1048576
PHIMANTEC_SURICATA_ALLOW_AC_FALLBACK=1

PHIMANTEC_DOCKER_BUILD_NETWORK=host

# v0.3.18 Appliance-Runtime.
# host = Dienste binden direkt im Host-Netzwerk; keine Docker-Port-NAT-Kette.
PHIMANTEC_RUNTIME_NETWORK=host

# v0.3.18: Ingress-Regeln werden durch das Appliance-Setup idempotent gesetzt.
# Das ist kein manuelles Host-Gefrickel, sondern Teil des Release-Setups.
PHIMANTEC_APPLIANCE_MANAGE_INGRESS=1
PHIMANTEC_APPLIANCE_INGRESS_IFACE=auto
PHIMANTEC_APPLIANCE_INGRESS_SOURCE=
PHIMANTEC_APPLIANCE_REQUIRE_INGRESS=1
# Hostseitige Vorab-Regel ist standardmaessig aus. Der suricata-node-Container
# setzt die Ingress-Regeln selbst im Host-Netzwerk-Namespace.
PHIMANTEC_APPLIANCE_HOST_PRE_APPLY_INGRESS=0
PHIMANTEC_APPLIANCE_INSTALL_INGRESS_SERVICE=0
PHIMANTEC_UBUNTU_BASE=ubuntu:24.04
PHIMANTEC_APT_RETRIES=0
PHIMANTEC_APT_TIMEOUT=12
PHIMANTEC_APT_FORCE_IPV4=1
PHIMANTEC_APT_MIRROR=
PHIMANTEC_APT_SECURITY_MIRROR=

PHIMANTEC_PREFLIGHT_STRICT_PORTS=1
PHIMANTEC_AUTO_REMOVE_LEGACY_CONTAINERS=0
PHIMANTEC_ALLOW_RENAMED_ROOT=0

# v0.3.5: Wechsel von einer v0.2-VM-/Lab-Installation.
# v0.2 betreibt phimantec-proxyd/-inspectord/-lane-sink als Host-systemd-Dienste.
# phimantec-proxyd belegt 0.0.0.0:3128 und blockiert sonst den Docker-Proxy.
# 1 = Preflight stoppt+deaktiviert diese Host-Dienste automatisch (benoetigt
#     root oder passwortloses sudo); 0 = nur warnen und mit Hinweis abbrechen.
# Manueller Weg jederzeit: scripts/phimantec_stop_legacy_host_services.sh
PHIMANTEC_AUTO_STOP_LEGACY_HOST_SERVICES=0

# v0.3.4: Docker-CA wird nach dem Start automatisch auf den Host exportiert.
# Leer = $HOME/phimantec-bump-ca.crt
PHIMANTEC_AUTO_EXPORT_CA=1
PHIMANTEC_CA_EXPORT_PATH=

# Nur bewusst setzen, wenn Proxy/Monitor lokal statt extern gebunden werden sollen.
PHIMANTEC_ALLOW_LOCAL_BIND=0

# 0 = lokaler Smoke ohne Internet; 1 = optionaler externer Proxy-Test.
PHIMANTEC_SMOKE_EXTERNAL=0

# v0.3.18: Suricata wird aus dem OISF-PPA installiert und muss >= 8 sein.
PHIMANTEC_SURICATA_APT_PPA=ppa:oisf/suricata-stable
PHIMANTEC_REQUIRE_SURICATA8=1

# v0.3.18: Root-CA muss browserfaehige CA-Erweiterungen besitzen.
# 0 = bestehende gueltige CA behalten; 1 = neue Root-CA erzeugen und exportieren.
PHIMANTEC_CA_CN=PHIMANTEC C11 Docker Lab Root CA
PHIMANTEC_REGENERATE_CA=0
