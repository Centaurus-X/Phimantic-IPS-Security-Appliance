[Unit]
Description=PHIMANTEC Lane Sink on Suricata Node
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/local/bin/phimantec-lane-sink -c /etc/phimantec/phimantec-suricata-node.conf
Restart=on-failure
RestartSec=5
User=phimantec
Group=phimantec

[Install]
WantedBy=multi-user.target
